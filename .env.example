ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/canaisdark.db
DATA_DIR=./data/files
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
SECRET_KEY=troque-por-um-valor-aleatorio
# Hosts extras aceitos no /mcp (ex.: domínio do Cloudflare Tunnel), separados por vírgula
MCP_ALLOWED_HOSTS=
# URL pública (Cloudflare Tunnel). Exige SECRET_KEY real. Ex.: https://canaisdark.russi.app
PUBLIC_URL=
# ElevenLabs (Fase 3): cole a chave AQUI (nunca no chat/commit)
ELEVENLABS_API_KEY=
# Teto de caracteres por geração de narração (protege os créditos do plano)
ELEVENLABS_MAX_CHARS_PER_JOB=2500
# Forced Alignment: false = nunca chama a API de alinhamento (tempos estimados). Útil em testes/plano grátis
FORCED_ALIGNMENT_ENABLED=true
# Tamanho de cada requisição de TTS (caracteres)
TTS_CHUNK_CHARS=1500
# Demonstração: true usa um ElevenLabs FALSO (sem chave, sem créditos, áudio sintético) para testar a interface
ELEVENLABS_FAKE=false
# Janela de "Desfazer" (segundos) antes de a narração começar a gastar créditos (0 = começa na hora)
NARRATION_UNDO_SECONDS=10
# Tamanho máximo de cada imagem/clipe enviado (MB). O Cloudflare corta acima de 100
MAX_UPLOAD_MB=100
# YouTube (Fase 7): Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth "Aplicativo da Web"
# URI de redirecionamento: <PUBLIC_URL>/oauth/youtube/callback  (dev: http://localhost:8123/oauth/youtube/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Demonstração: true usa um YouTube FALSO (sem Google, sem upload real)
YOUTUBE_FAKE=false
# Cota diária da YouTube Data API (cada upload gasta cerca de 1.650 unidades)
YOUTUBE_DAILY_QUOTA=10000
# Google Drive (Fase 8): mesmo cliente OAuth acima, com a Google Drive API ativada e o redirect
# <PUBLIC_URL>/oauth/drive/callback cadastrado. true = Drive FALSO (demonstração, sem rede)
DRIVE_FAKE=false
